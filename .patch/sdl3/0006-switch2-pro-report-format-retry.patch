--- a/src/joystick/hidapi/SDL_hidapi_switch2.c
+++ b/src/joystick/hidapi/SDL_hidapi_switch2.c
@@ -109,6 +109,9 @@
     Uint32 rumble_error;
     bool rumble_updated;
 
+    Uint64 report_format_request_ns;
+    int report_format_requests;
+
     Switch2_StickCalibration left_stick;
     Switch2_StickCalibration right_stick;
     Uint8 left_trigger_zero;
@@ -1171,6 +1174,25 @@
 
     if (size < 64) {
         // We don't know how to handle this report
+        return;
+    }
+
+    if (device->product_id == USB_PRODUCT_NINTENDO_SWITCH2_PRO && data[0] != 0x05) {
+        /* A pad that has just been plugged in can ignore the report format set during init and keep
+         * sending its default format (report 0x09), which HandleSwitchProState can't parse. Ask again,
+         * up to 20 times, until it switches. */
+        if (ctx->interface_claimed && ctx->report_format_requests < 20 &&
+            timestamp - ctx->report_format_request_ns >= SDL_MS_TO_NS(250)) {
+            static const Uint8 set_report_format[] = {
+                0x03, 0x91, 0x00, 0x0a, 0x00, 0x04, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00
+            };
+            Uint8 reply[0x40];
+            ctx->report_format_request_ns = timestamp;
+            ++ctx->report_format_requests;
+            if (SendBulkData(ctx, set_report_format, sizeof(set_report_format)) > 0) {
+                RecvBulkData(ctx, reply, sizeof(reply));
+            }
+        }
         return;
     }
 
