+
+#ifdef SDL_PLATFORM_MACOS
+/* The HID interface was opened through IOKit, which leaves the vendor bulk interface free: open the
+ * device with libusb and claim only that one. Devices are matched by vendor and product only, so with
+ * two pads of one model a pad can get the other's bulk interface: both are initialized, but serial,
+ * stick calibration, player LED and sensor enable can be swapped between them. */
+static bool OpenOwnBulkInterface(SDL_DriverSwitch2_Context *ctx, SDL_HIDAPI_Device *device)
+{
+    SDL_LibUSBContext *libusb = ctx->libusb;
+    libusb_device **list;
+
+    if (libusb->init(&ctx->own_usb_context) < 0) {
+        ctx->own_usb_context = NULL;
+        return SDL_SetError("Couldn't initialize libusb");
+    }
+    ssize_t count = libusb->get_device_list(ctx->own_usb_context, &list);
+    for (ssize_t i = 0; i < count && !ctx->interface_claimed; ++i) {
+        struct libusb_device_descriptor desc;
+        libusb_device_handle *handle;
+        if (libusb->get_device_descriptor(list[i], &desc) < 0 ||
+            desc.idVendor != device->vendor_id || desc.idProduct != device->product_id ||
+            libusb->open(list[i], &handle) < 0) {
+            continue;
+        }
+        if (FindBulkEndpoints(libusb, handle, &ctx->interface_number, &ctx->out_endpoint, &ctx->in_endpoint) &&
+            libusb->claim_interface(handle, ctx->interface_number) == 0) {
+            ctx->device_handle = handle;
+            ctx->interface_claimed = true;
+        } else {
+            libusb->close(handle);
+        }
+    }
+    if (count >= 0) {
+        libusb->free_device_list(list, 1);
+    }
+    if (!ctx->interface_claimed) {
+        libusb->exit(ctx->own_usb_context);
+        ctx->own_usb_context = NULL;
+        return SDL_SetError("Couldn't claim the bulk interface of a Switch 2 controller");
+    }
+    return true;
 }
+#endif
 
